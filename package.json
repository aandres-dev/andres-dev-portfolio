{
  "name": "andres-dev-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Andres Lopez <andres.{dev}> AI Orchestrator Portfolio",
  "scripts": {
    "test": "node script/validate-comments.js && node script/validate-commit-attribution.js && node script/csp.js --check && node script/build-i18n.js --check && node script/validate.js && node test/markup.test.js && node test/headers.test.js && node test/validate.test.js && node test/stress-audit.js && node --test test/build-i18n.test.js test/validate-comments.test.js test/validate-commit-attribution.test.js test/form.test.js",
    "test:markup": "node test/markup.test.js",
    "test:headers": "node test/headers.test.js",
    "validate": "node script/validate.js",
    "test:stress": "node test/stress-audit.js",
    "test:unit": "node --test test/build-i18n.test.js test/validate-comments.test.js test/validate-commit-attribution.test.js test/form.test.js",
    "coverage:gaps": "node script/coverage-gaps.js",
    "test:coverage-gaps": "node test/coverage-gaps.test.js",
    "csp": "node script/csp.js",
    "e2e": "playwright test",
    "test:all": "pnpm test && pnpm e2e",
    "i18n": "node script/build-i18n.js",
    "comments": "node script/validate-comments.js"
  },
  "packageManager": "pnpm@11.3.0",
  "author": "Andres Lopez",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1"
  }
}
